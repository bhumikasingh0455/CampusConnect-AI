PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-deployment.vercel.app
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
UPLOAD_PATH=uploads
MAX_FILE_SIZE_MB=10
